@page "{id:long?}"
@model AILibrary.Pages.Admin.Types.EditModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Editar Tipo" : "Novo Tipo";
}

<div class="admin-section-header" style="max-width: 800px; margin: 0 auto 2rem;">
    <div>
        <h1 class="page-title" style="font-size: 32px; margin-bottom: 0.25rem;">@(Model.IsEditMode ? "Editar Tipo" : "Novo Tipo")</h1>
        <p style="color: var(--text-secondary); font-size: 13px;">Preencha as informações do tipo abaixo.</p>
    </div>
</div>

<div class="admin-form-container">
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />

        <div class="form-group">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" placeholder="Ex: Skill, Plugin, Ferramenta..." autocomplete="off" autofocus />
            <span asp-validation-for="Input.Name" class="validation-error-msg"></span>
        </div>

        <div class="form-actions-row">
            <a asp-page="./Index" class="admin-btn admin-btn-secondary">Cancelar</a>
            <button type="submit" class="admin-btn admin-btn-primary">Salvar Alterações</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
